# Admin-uploaded photos. Only serve images; never execute anything placed here.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .phar .cgi .pl .py
RemoveType .php .phtml .phar
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<FilesMatch "(?i)\.(php\d?|phtml|phar|cgi|pl|py|sh|html?|svg)$">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
